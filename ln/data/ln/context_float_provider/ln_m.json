{
    "type": "conditional",
    "condition": {
        "type": "float_value_check",
        "value": {
            "type": "storage",
            "storage": "ln.math",
            "path": "input"
        },
        "test": {
            "max": 1
        }
    },
    "on_true": {
        "type": "div",
        "left": {
            "type": "storage",
            "storage": "ln.math",
            "path": "input"
        },
        "right": {
            "type": "pow",
            "base": 2,
            "exponent": "ln:ln_e"
        }
    },
    "on_false": {
        "type": "mul",
        "inputs": [
            {
                "type": "storage",
                "storage": "ln.math",
                "path": "input"
            },
            {
                "type": "pow",
                "base": 2,
                "exponent": {
                    "type": "negate",
                    "input": "ln:ln_e"
                }
            }
        ]
    }
}